# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# DATABASE_URL: PostgreSQL connection string for the built-in CMS database.
# Deploy on Supabase (Project Settings > Database > Connection string) or any PostgreSQL 15+.
# When set, the CMS runs on Postgres; when unset, a local DuckDB engine is used.
DATABASE_URL="postgresql://postgres:password@db.xxxx.supabase.co:5432/postgres"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# JWT_SECRET: Secret for signing JWT tokens.
JWT_SECRET="MY_JWT_SECRET"

# Stripe: Required for billing and checkout.
# Get these from the Stripe Dashboard (Developers > API keys).
STRIPE_SECRET_KEY="sk_test_..."
VITE_STRIPE_PUBLISHABLE_KEY="pk_test_..."
